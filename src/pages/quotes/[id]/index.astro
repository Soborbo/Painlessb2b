---
import Layout from '../../../layouts/Layout.astro';
import QuoteDetail from '../../../components/QuoteApp/QuoteDetail';
import { getCfEnv } from '../../../lib/cf-env';
import { getQuote, listEvents } from '../../../quotes/db';
import { getTemplateMeta } from '../../../quotes/templates';

const id = Astro.params.id;
if (!id) return Astro.redirect('/quotes');

const cfEnv = await getCfEnv();
const quote = await getQuote(cfEnv.DB, id);
if (!quote) return new Response('Not found', { status: 404 });

// Drafts go to the editor; the detail view is for already-sent quotes.
if (quote.status === 'draft') {
  return Astro.redirect(`/quotes/${id}/edit`);
}

const template = getTemplateMeta(quote.template_id);
if (!template) return new Response('Template missing', { status: 500 });

const events = await listEvents(cfEnv.DB, id);
---
<Layout title={`Quote #${quote.id.slice(0, 8)} — Painless Removals`}>
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <QuoteDetail
    quote={quote}
    template={template}
    events={events}
    client:only="react"
  />
</Layout>
