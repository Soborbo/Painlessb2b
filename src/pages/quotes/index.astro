---
import Layout from '../../layouts/Layout.astro';
import { getCfEnv } from '../../lib/cf-env';
import { listQuotes } from '../../quotes/db';
import { listTemplates } from '../../quotes/templates';
import { QUOTE_STATUSES } from '../../quotes/types';
import type { QuoteStatus } from '../../quotes/types';

const cfEnv = await getCfEnv();
const statusFilterRaw = Astro.url.searchParams.get('status');
const statusFilter: QuoteStatus[] | undefined = statusFilterRaw
  ? statusFilterRaw
      .split(',')
      .filter((s): s is QuoteStatus =>
        (QUOTE_STATUSES as readonly string[]).includes(s)
      )
  : undefined;

const quotes = await listQuotes(cfEnv.DB, {
  status: statusFilter && statusFilter.length > 0 ? statusFilter : undefined,
  limit: 200,
});
const templates = listTemplates();
const templateNameById = new Map(templates.map((t) => [t.id, t.name]));

const STATUS_LABELS: Record<QuoteStatus, string> = {
  draft: 'Draft',
  sent: 'Sent',
  opened: 'Opened',
  clicked: 'Clicked',
  replied: 'Replied',
  won: 'Won',
  lost: 'Lost',
  expired: 'Expired',
};
const STATUS_CLASSES: Record<QuoteStatus, string> = {
  draft: 'bg-gray-100 text-gray-700',
  sent: 'bg-blue-100 text-blue-800',
  opened: 'bg-indigo-100 text-indigo-800',
  clicked: 'bg-violet-100 text-violet-800',
  replied: 'bg-amber-100 text-amber-800',
  won: 'bg-emerald-100 text-emerald-800',
  lost: 'bg-rose-100 text-rose-800',
  expired: 'bg-gray-200 text-gray-600',
};

function timeAgo(iso: string | null): string {
  if (!iso) return '—';
  const norm = iso.replace(' ', 'T') + 'Z';
  const t = new Date(norm).getTime();
  if (isNaN(t)) return iso;
  const diff = Date.now() - t;
  const m = Math.floor(diff / 60_000);
  if (m < 1) return 'just now';
  if (m < 60) return `${m}m ago`;
  const h = Math.floor(m / 60);
  if (h < 24) return `${h}h ago`;
  const d = Math.floor(h / 24);
  return `${d}d ago`;
}

function fmtMoney(pence: number | null): string {
  if (pence === null) return '';
  return '£' + (pence / 100).toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}
---
<Layout title="Quotes — Painless Removals">
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <main class="mx-auto max-w-6xl px-6 py-10">
    <header class="mb-6 flex items-center justify-between">
      <h1 class="text-2xl font-semibold">Quotes</h1>
      <a
        href="/quotes/new"
        class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500"
      >
        New quote
      </a>
    </header>

    <nav class="mb-6 flex flex-wrap gap-2 text-sm">
      <a
        href="/quotes"
        class={`rounded-md px-3 py-1.5 ${!statusFilterRaw ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}`}
      >
        All
      </a>
      {QUOTE_STATUSES.map((s) => {
        const active = statusFilterRaw === s;
        return (
          <a
            href={`/quotes?status=${s}`}
            class={`rounded-md px-3 py-1.5 ${active ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}`}
          >
            {STATUS_LABELS[s]}
          </a>
        );
      })}
    </nav>

    {quotes.length === 0 ? (
      <div class="rounded-lg border border-dashed border-gray-300 p-12 text-center">
        <p class="text-gray-500">
          {statusFilterRaw ? `No quotes with status "${statusFilterRaw}".` : 'No quotes yet.'}
        </p>
        <a href="/quotes/new" class="mt-3 inline-block text-sm text-indigo-600 hover:underline">
          Start a new quote →
        </a>
      </div>
    ) : (
      <div class="overflow-hidden rounded-lg border border-gray-200">
        <table class="w-full divide-y divide-gray-200 bg-white text-sm">
          <thead class="bg-gray-50 text-left text-xs uppercase tracking-wider text-gray-500">
            <tr>
              <th class="px-4 py-2.5">Recipient</th>
              <th class="px-4 py-2.5">Template</th>
              <th class="px-4 py-2.5">Status</th>
              <th class="px-4 py-2.5">Deal value</th>
              <th class="px-4 py-2.5">Last activity</th>
              <th class="px-4 py-2.5"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {quotes.map((q) => (
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3">
                  <div class="font-medium text-gray-900">
                    {q.recipient_email ?? <span class="italic text-gray-400">no recipient</span>}
                  </div>
                  {q.recipient_name && (
                    <div class="text-xs text-gray-500">{q.recipient_name}</div>
                  )}
                </td>
                <td class="px-4 py-3 text-gray-600">
                  {templateNameById.get(q.template_id) ?? q.template_id}
                </td>
                <td class="px-4 py-3">
                  <span class={`inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ${STATUS_CLASSES[q.status]}`}>
                    {STATUS_LABELS[q.status]}
                  </span>
                </td>
                <td class="px-4 py-3 text-gray-700">
                  {fmtMoney(q.deal_value_pence)}
                </td>
                <td class="px-4 py-3 text-gray-500">
                  {timeAgo(q.last_activity_at ?? q.updated_at)}
                </td>
                <td class="px-4 py-3 text-right">
                  <a
                    href={q.status === 'draft' ? `/quotes/${q.id}/edit` : `/quotes/${q.id}`}
                    class="text-sm text-indigo-600 hover:underline"
                  >
                    {q.status === 'draft' ? 'Edit' : 'View'}
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </main>
</Layout>
